# Google Sheets (необязательно). Путь к JSON сервисного аккаунта Google Cloud.
GOOGLE_SERVICE_ACCOUNT=service_account.json
# ID таблицы из адресной строки: https://docs.google.com/spreadsheets/d/<ID>/edit
GOOGLE_SHEET_ID=
# Прокси, если сайт блокирует ваш регион (http://user:pass@host:port или socks5://...)
PROXY=
